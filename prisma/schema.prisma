// ==============================================================================
// DIANO E-Commerce Platform — Complete Enterprise Prisma Schema (Prisma 7)
// ==============================================================================
// Datasource configuration is centrally managed via prisma.config.ts
// Standards:
// - IDs: String @id @default(cuid())
// - Monetary values: Decimal @db.Decimal(12, 2)
// - Quantities: Int (no Float)
// - Time: UTC DateTime (@default(now())), business timezone Asia/Dhaka
// - Soft delete: User, Product, ProductVariant, Category, Coupon, Supplier
// - Immutable append-only: Order, OrderItem, Payment, StockMovement, AuditLog
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum RoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ORDER_MANAGER
  INVENTORY_MANAGER
  SUPPORT_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING_VERIFICATION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PROCESSING
  PAID
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  SSLCOMMERZ
  BKASH
  NAGAD
  COD
}

enum BannerPlacement {
  HOME_HERO
  HOME_SECONDARY
  CATEGORY_TOP
  ANNOUNCEMENT_BAR
  POPUP
}

enum PageType {
  POLICY
  ABOUT
  FAQ
  CUSTOM
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  RECEIVED
  INSPECTED
  REFUNDED
  REPLACED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
  RETURNING
  RETURNED
}

enum CheckoutStatus {
  ACTIVE
  ABANDONED
  RECOVERED
  CONVERTED
  EXPIRED
}

enum CheckoutEventType {
  CHECKOUT_STARTED
  CUSTOMER_INFO_ENTERED
  SHIPPING_INFO_ENTERED
  PAYMENT_METHOD_SELECTED
  CHECKOUT_STEP_COMPLETED
  CHECKOUT_ABANDONED
  ORDER_PLACED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ORDER_RESERVATION
  ORDER_RELEASE
  ORDER_FULFILLMENT
  ORDER_CANCELLATION
  RETURN_RESTOCK
  DAMAGE_ADJUSTMENT
  AUDIT_ADJUSTMENT
  MANUAL_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FraudReviewStatus {
  PENDING
  AUTO_APPROVED
  MANUAL_REVIEW
  APPROVED
  REJECTED
  OTP_REQUESTED
}

enum CouponType {
  FIXED
  PERCENTAGE
  FREE_SHIPPING
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ConsentChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum DeviceCategory {
  DESKTOP
  MOBILE
  TABLET
  OTHER
}

enum ProductImageSlot {
  THUMBNAIL
  BACKVIEW
  GALLERY
}

enum InventoryType {
  READY_STOCK
  PRE_ORDER
  MADE_TO_ORDER
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

// ==============================================================================
// AUTHENTICATION & RBAC
// ==============================================================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  phone               String?    @unique
  passwordHash        String
  name                String
  avatarUrl           String?
  status              UserStatus @default(ACTIVE)
  isEmailVerified     Boolean    @default(false)
  isPhoneVerified     Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockUntil           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relationships
  roles                  UserRole[]
  sessions               Session[]
  refreshTokens          RefreshToken[]
  loginHistories         LoginHistory[]
  profile                CustomerProfile?
  addresses              CustomerAddress[]
  consentRecords         ConsentRecord[]
  cart                   Cart?
  wishlist               Wishlist?
  orders                 Order[]
  checkoutSessions       CheckoutSession[]
  reviews                Review[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  couponUsages           CouponUsage[]
  returnRequests         ReturnRequest[]
  pageRevisions          PageRevision[]
  productViews           ProductView[]
  emailTokens            EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]

  @@index([email])
  @@index([phone])
  @@index([status, deletedAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  type        RoleType @default(CUSTOMER)
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([slug])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id             String         @id @default(cuid())
  userId         String
  tokenHash      String         @unique
  deviceCategory DeviceCategory @default(DESKTOP)
  browser        String?
  os             String?
  ip             String?
  userAgent      String?
  isRevoked      Boolean        @default(false)
  revokedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  replacedByTokenId String?
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  usedAt            DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  status    String // SUCCESS, FAILED
  reason    String?
  ip        String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model OtpCode {
  id          String   @id @default(cuid())
  identifier  String // email or phone
  codeHash    String
  purpose     String // LOGIN, REGISTRATION, PASSWORD_RESET, CHECKOUT
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([identifier, purpose])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ==============================================================================
// CUSTOMER PROFILE, ADDRESSES & CONSENT
// ==============================================================================

model CustomerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  dateOfBirth   DateTime?
  gender        String?
  loyaltyPoints Int       @default(0)
  totalSpent    Decimal   @default(0.00) @db.Decimal(12, 2)
  ordersCount   Int       @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id               String      @id @default(cuid())
  userId           String
  type             AddressType @default(SHIPPING)
  isDefault        Boolean     @default(false)
  fullName         String
  phone            String
  alternativePhone String?
  addressLine      String
  district         String
  city             String
  area             String?
  postalCode       String?
  landmark         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([district])
}

model ConsentRecord {
  id         String         @id @default(cuid())
  userId     String?
  guestEmail String?
  guestPhone String?
  channel    ConsentChannel
  purpose    String // MARKETING, RECOVERY, ANALYTICS
  isGranted  Boolean        @default(true)
  grantedAt  DateTime       @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  recoveryAttempts RecoveryAttempt[]

  @@index([userId, purpose])
  @@index([guestEmail, purpose])
  @@index([guestPhone, purpose])
}

// ==============================================================================
// CATALOG & PRODUCTS
// ==============================================================================

model Category {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  description           String?
  image                 String?
  parentId              String?
  specificationTemplate Json      @default("[]")
  isFeatured            Boolean   @default(false)
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive, deletedAt])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String
  shortDescription String?
  categoryId       String
  videoUrl         String?
  freeShipping     Boolean       @default(false)
  inventoryType    InventoryType @default(READY_STOCK)
  specifications   Json          @default("{}")
  discountType     DiscountType  @default(NONE)
  discountValue    Decimal?      @db.Decimal(12, 2)
  specialOffer     Boolean       @default(false)
  mrp              Decimal?      @db.Decimal(12, 2)
  status           String        @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isFeatured       Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  viewCount        Int           @default(0)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  tags          ProductTag[]
  relatedFrom   RelatedProduct[] @relation("ProductRelatedFrom")
  relatedTo     RelatedProduct[] @relation("ProductRelatedTo")
  reviews       Review[]
  productViews  ProductView[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([status, deletedAt])
  @@index([isFeatured])
  @@index([inventoryType])
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  name           String
  sku            String    @unique
  barcode        String?   @unique
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  costPrice      Decimal?  @db.Decimal(12, 2)
  reorderLevel   Int       @default(5)
  attributes     Json      @default("{}")
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  inventories        Inventory[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  stockAuditItems    StockAuditItem[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  flashSaleItems     FlashSaleItem[]
  wishlistItems      WishlistItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive, deletedAt])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  variantId String?
  slot      ProductImageSlot @default(GALLERY)
  url       String
  publicId  String?
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  altText   String?
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([productId, slot])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  values    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  productTags ProductTag[]

  @@index([slug])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model RelatedProduct {
  productId        String
  relatedProductId String

  product        Product @relation("ProductRelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
}

// ==============================================================================
// INVENTORY & WAREHOUSE
// ==============================================================================

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories    Inventory[]
  stockMovements StockMovement[]
  stockAudits    StockAudit[]
  purchaseOrders PurchaseOrder[]

  @@index([code])
}

model Inventory {
  id          String   @id @default(cuid())
  variantId   String
  warehouseId String
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  damaged     Int      @default(0)
  safetyStock Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
}

model StockMovement {
  id             String            @id @default(cuid())
  variantId      String
  warehouseId    String
  type           StockMovementType
  action         String? // RESERVE, RELEASE, COMMIT, RECEIVE, ADJUST, DAMAGE, RESTOCK, TRANSFER_IN, TRANSFER_OUT
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  reason         String
  referenceType  String // ORDER, PURCHASE_ORDER, AUDIT, MANUAL, RETURN, TRANSFER
  referenceId    String
  actorId        String?
  createdAt      DateTime          @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId])
  @@index([referenceType, referenceId])
  @@index([variantId, createdAt])
  @@index([createdAt])
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([code])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  supplierId           String
  warehouseId          String?
  status               PurchaseOrderStatus @default(DRAFT)
  totalAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  orderedAt            DateTime?
  expectedDeliveryDate DateTime?
  receivedAt           DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  orderedQuantity  Int
  receivedQuantity Int      @default(0)
  unitCost         Decimal  @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([variantId])
}

model StockAudit {
  id                 String    @id @default(cuid())
  warehouseId        String
  auditorId          String
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, APPROVED, REJECTED, COMPLETED
  discrepanciesFound Int       @default(0)
  notes              String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     StockAuditItem[]

  @@index([warehouseId])
}

model StockAuditItem {
  id              String   @id @default(cuid())
  auditId         String
  variantId       String
  systemQuantity  Int      @default(0)
  countedQuantity Int      @default(0)
  variance        Int      @default(0) // countedQuantity - systemQuantity
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  audit   StockAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([auditId, variantId])
  @@index([auditId])
  @@index([variantId])
}

// ==============================================================================
// CART & WISHLIST
// ==============================================================================

model Cart {
  id         String    @id @default(cuid())
  userId     String?   @unique
  guestToken String?   @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([guestToken])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  quantity      Int
  priceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
}

// ==============================================================================
// CHECKOUT & ABANDONED CHECKOUT
// ==============================================================================

model CheckoutSession {
  id                String         @id @default(cuid())
  sessionId         String         @unique // public checkout session ID
  userId            String?
  status            CheckoutStatus @default(ACTIVE)
  cartSnapshot      Json
  checkoutValue     Decimal        @db.Decimal(12, 2)
  lastCompletedStep String?
  deviceCategory    DeviceCategory @default(DESKTOP)
  browser           String?
  ipAddress         String?
  consentStatus     String?
  lastActivityAt    DateTime       @default(now())
  abandonedAt       DateTime?
  recoveredAt       DateTime?
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  events           CheckoutEvent[]
  recoveryAttempts RecoveryAttempt[]

  @@index([status, lastActivityAt])
  @@index([userId])
  @@index([sessionId])
}

model CheckoutEvent {
  id                String            @id @default(cuid())
  checkoutSessionId String
  type              CheckoutEventType
  metadata          Json              @default("{}") // strictly no PII
  occurredAt        DateTime          @default(now())

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@index([checkoutSessionId])
  @@index([type])
}

model RecoveryAttempt {
  id                String              @id @default(cuid())
  checkoutSessionId String
  channel           NotificationChannel
  status            String              @default("SENT")
  sentAt            DateTime            @default(now())
  consentRecordId   String?
  metadata          Json?

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  consentRecord   ConsentRecord?  @relation(fields: [consentRecordId], references: [id], onDelete: SetNull)

  @@index([checkoutSessionId])
}

// ==============================================================================
// ORDERS & ORDER ITEMS
// ==============================================================================

model Order {
  id                      String          @id @default(cuid())
  orderNumber             String          @unique
  idempotencyKey          String?         @unique
  customerId              String
  status                  OrderStatus     @default(PENDING)
  subtotal                Decimal         @db.Decimal(12, 2)
  discountTotal           Decimal         @default(0.00) @db.Decimal(12, 2)
  shippingTotal           Decimal         @default(0.00) @db.Decimal(12, 2)
  taxTotal                Decimal         @default(0.00) @db.Decimal(12, 2)
  grandTotal              Decimal         @db.Decimal(12, 2)
  paymentStatus           PaymentStatus   @default(PENDING)
  paymentMethod           PaymentProvider
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json?
  customerSnapshot        Json
  couponId                String?
  notes                   String?
  placedAt                DateTime        @default(now())
  paymentDeadline         DateTime?
  confirmedAt             DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  customer        User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coupon          Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage     CouponUsage?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  orderNotes      OrderNote[]
  payments        Payment[]
  refunds         Refund[]
  shipment        Shipment?
  fraudAssessment FraudAssessment?
  returnRequests  ReturnRequest[]
  invoiceSnapshot OrderInvoiceSnapshot?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([paymentDeadline])
  @@index([orderNumber])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  variantId          String?
  productName        String
  variantName        String
  sku                String
  unitPrice          Decimal  @db.Decimal(12, 2)
  costPrice          Decimal? @db.Decimal(12, 2)
  quantity           Int
  discount           Decimal  @default(0.00) @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(12, 2)
  attributesSnapshot Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]
  reviews     Review[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String?
  note        String?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderNote {
  id                String   @id @default(cuid())
  orderId           String
  authorId          String?
  note              String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ==============================================================================
// PAYMENTS & REFUNDS
// ==============================================================================

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BDT")
  transactionId     String?
  providerReference String?
  bankTranId        String?
  idempotencyKey    String?         @unique
  paymentFee        Decimal         @default(0.00) @db.Decimal(12, 2)
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([provider, transactionId])
  @@index([orderId])
  @@index([status])
  @@index([provider])
}

model PaymentEvent {
  id                 String          @id @default(cuid())
  paymentId          String
  provider           PaymentProvider
  eventId            String
  eventType          String
  rawPayloadRedacted Json
  signatureValid     Boolean         @default(true)
  processedAt        DateTime        @default(now())
  createdAt          DateTime        @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([paymentId])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  orderId          String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String
  status           RefundStatus @default(PENDING)
  processedById    String?
  providerRefundId String?
  idempotencyKey   String?      @unique
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
}

// ==============================================================================
// FRAUD DETECTION
// ==============================================================================

model FraudRule {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?
  weight      Int      @default(10)
  isEnabled   Boolean  @default(true)
  parameters  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FraudAssessment {
  id             String            @id @default(cuid())
  orderId        String            @unique
  riskScore      Int // 0 to 100
  riskLevel      FraudRiskLevel
  triggeredRules Json              @default("[]")
  factors        Json              @default("{}")
  explanation    String?
  reviewStatus   FraudReviewStatus @default(PENDING)
  decidedById    String?
  decision       String?
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  decisionHistory FraudDecisionHistory[]

  @@index([riskLevel])
  @@index([reviewStatus])
}

model FraudDecisionHistory {
  id                String            @id @default(cuid())
  fraudAssessmentId String
  actorId           String
  previousStatus    FraudReviewStatus
  newStatus         FraudReviewStatus
  reason            String
  createdAt         DateTime          @default(now())

  fraudAssessment FraudAssessment @relation(fields: [fraudAssessmentId], references: [id], onDelete: Cascade)

  @@index([fraudAssessmentId])
}

// ==============================================================================
// SHIPPING & LOGISTICS
// ==============================================================================

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  districts Json // Array of district names
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]
}

model ShippingMethod {
  id                    String   @id @default(cuid())
  shippingZoneId        String
  name                  String
  code                  String   @unique
  baseCharge            Decimal  @db.Decimal(12, 2)
  perKgCharge           Decimal  @default(0.00) @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  estimatedDays         String
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shippingZone ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Restrict)
  shipments    Shipment[]

  @@index([shippingZoneId])
}

model Shipment {
  id               String         @id @default(cuid())
  orderId          String         @unique
  shippingMethodId String?
  courierName      String
  trackingNumber   String?        @unique
  status           ShipmentStatus @default(PENDING)
  labelUrl         String?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod?   @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  events         ShipmentEvent[]
  attempts       DeliveryAttempt[]

  @@index([status])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model DeliveryAttempt {
  id            String   @id @default(cuid())
  shipmentId    String
  attemptNumber Int      @default(1)
  status        String
  reason        String?
  attemptedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ==============================================================================
// COUPONS & DISCOUNTS
// ==============================================================================

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType @default(PERCENTAGE)
  value          Decimal    @db.Decimal(12, 2)
  minPurchase    Decimal    @default(0.00) @db.Decimal(12, 2)
  maxDiscount    Decimal?   @db.Decimal(12, 2)
  startsAt       DateTime
  expiresAt      DateTime
  usageLimit     Int?
  perUserLimit   Int        @default(1)
  usedCount      Int        @default(0)
  firstOrderOnly Boolean    @default(false)
  allowOnSale    Boolean    @default(true)
  scopes         Json?      @default("{}")
  isActive       Boolean    @default(true)
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]
  usages CouponUsage[]

  @@index([code])
  @@index([isActive, deletedAt])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  orderId        String   @unique
  userId         String
  discountAmount Decimal  @db.Decimal(12, 2)
  usedAt         DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([userId])
}

model FlashSale {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items FlashSaleItem[]

  @@index([isActive, startsAt, endsAt])
}

model FlashSaleItem {
  id            String  @id @default(cuid())
  flashSaleId   String
  variantId     String
  discountPrice Decimal @db.Decimal(12, 2)
  stockLimit    Int
  soldCount     Int     @default(0)

  flashSale FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([flashSaleId, variantId])
  @@index([flashSaleId])
}

// ==============================================================================
// RETURNS & REFUND REQUESTS
// ==============================================================================

model ReturnReason {
  id        String   @id @default(cuid())
  reason    String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  returnRequests ReturnRequest[]
}

model ReturnRequest {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  orderId      String
  customerId   String
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @db.Decimal(12, 2)
  reasonId     String?
  customerNote String?
  staffNote    String?
  requestedAt  DateTime     @default(now())
  inspectedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reason   ReturnReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  items    ReturnItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model ReturnItem {
  id              String   @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  condition       String?
  action          String? // REFUND, REPLACE, REJECT
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([returnRequestId])
  @@index([orderItemId])
}

// ==============================================================================
// REVIEWS & RATINGS
// ==============================================================================

model Review {
  id                 String       @id @default(cuid())
  userId             String
  productId          String
  orderItemId        String?
  rating             Int // 1 to 5
  title              String?
  comment            String
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images    ReviewImage[]

  @@unique([userId, productId])
  @@index([productId, status])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// ==============================================================================
// NOTIFICATIONS & PREFERENCES
// ==============================================================================

model Notification {
  id            String              @id @default(cuid())
  userId        String?
  channel       NotificationChannel
  recipient     String // Email or Phone
  template      String
  subject       String?
  content       String
  metadata      Json                @default("{}")
  status        NotificationStatus  @default(PENDING)
  dedupeKey     String?             @unique
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([channel])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  emailMarketing  Boolean  @default(true)
  smsMarketing    Boolean  @default(true)
  orderUpdates    Boolean  @default(true)
  promotionalPush Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==============================================================================
// AUDIT LOGS, SETTINGS & ANALYTICS
// ==============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String // USER, SYSTEM, GUEST, WEBHOOK
  action     String // e.g. ORDER_STATUS_UPDATED, USER_LOCKED, STOCK_ADJUSTED
  targetType String // ORDER, PRODUCT, USER, PAYMENT, etc.
  targetId   String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json     @default("{}") // strictly safe, non-PII, no secrets
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ==============================================================================
// CMS: BANNERS & PAGES
// ==============================================================================

model Banner {
  id           String          @id @default(cuid())
  placement    BannerPlacement
  title        String
  subtitle     String?
  desktopImage String
  mobileImage  String?
  altText      String?
  linkUrl      String?
  ctaText      String?
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([placement, isActive])
  @@index([startsAt, endsAt])
  @@index([sortOrder])
}

model Page {
  id              String         @id @default(cuid())
  slug            String         @unique
  type            PageType       @default(CUSTOM)
  title           String
  content         Json           @default("[]")
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  status          PageStatus     @default(DRAFT)
  publishedAt     DateTime?
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  revisions PageRevision[]

  @@index([slug])
  @@index([status])
  @@index([type])
}

model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  version     Int
  title       String
  content     Json
  publishedAt DateTime @default(now())
  authorId    String?
  createdAt   DateTime @default(now())

  page   Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId, version])
  @@index([pageId])
}

// ==============================================================================
// INVOICE SNAPSHOTS
// ==============================================================================

model OrderInvoiceSnapshot {
  id              String   @id @default(cuid())
  orderId         String   @unique
  invoiceNumber   String   @unique
  storeProfile    Json
  invoiceSettings Json
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([invoiceNumber])
  @@index([orderId])
}

model AppSequence {
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AnalyticsDailySummary {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  metricKey   String // e.g. GMV, TOTAL_ORDERS, NEW_CUSTOMERS, CONVERSION_RATE
  metricValue Decimal  @db.Decimal(18, 4)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@unique([date, metricKey])
  @@index([metricKey, date])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?
  viewedAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, viewedAt])
  @@index([userId])
}
