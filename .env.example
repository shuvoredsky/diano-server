# ==========================================
# DIANO BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost
API_PREFIX=/api/v1
APP_NAME=diano-server
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://diano:diano_dev_password@localhost:5432/diano_dev?schema=public

# Redis Configuration (BullMQ, Caching, Session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT & Authentication Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_SECRET=change_this_to_another_secure_random_string_min_32_chars
JWT_RESET_PASSWORD_EXPIRES_IN=1h
COOKIE_SECRET=change_this_to_another_secure_random_string_min_32_chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Business Defaults
DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka

# Cloudinary (Media Storage - Optional in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP / Nodemailer - Optional in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@diano.com
